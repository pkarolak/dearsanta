# Public URL used in e-mails and calendar invites (production: https://drogimikolaju.pl).
APP_URL=http://localhost:3000

# Secret used to sign session cookies and magic links. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres connection string (Supabase -> Project Settings -> Database -> Connection pooling, "Transaction" mode).
# Leave empty to use the embedded PGlite database stored in .data/pglite (local development).
DATABASE_URL=

# E-mail. Leave RESEND_API_KEY empty to capture all e-mails in the local dev inbox at /dev/mail.
RESEND_API_KEY=
MAIL_FROM="Drogi Mikołaju! <kontakt@drogimikolaju.pl>"

# Santa's voice. Leave empty to fall back to the browser's built-in speech synthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
